<Project Sdk="Microsoft.Build.Sql">
  <!--
    Scripted data migrations: the changes a declarative model cannot express (backfills, renames,
    splitting a column). The dacpac has no schema objects; it only carries a post-deployment script.
    It is published before the schema dacpac, without the publish profile.

    Add a migration as Migrations\NNNN_Description\*.sql and run scripts/New-MigrationScripts.ps1.
    Never edit Scripts\Generated by hand: CI fails when it differs from what the script generates.
  -->
  <PropertyGroup>
    <Name>Shop.Database.Migrations</Name>
  </PropertyGroup>

  <ItemGroup>
    <Build Remove="**\*.sql" />
    <PostDeploy Include="Scripts\Script.PostDeployment.sql" />
    <None Include="Scripts\Generated\*.sql" />
    <None Include="Migrations\**\*.sql" />
  </ItemGroup>
</Project>
