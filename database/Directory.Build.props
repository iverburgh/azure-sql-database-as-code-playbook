<Project>
  <!-- Shared by every SQL project: all of them target Azure SQL Database, so sqlpackage never sees two platforms. -->
  <PropertyGroup>
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlAzureV12DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <TreatTSqlWarningsAsErrors>True</TreatTSqlWarningsAsErrors>
    <!-- The pipeline passes /p:Version=<build number>, so every dacpac says which build produced it. -->
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <DacVersion>$(Version)</DacVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Every dacpac that runs scripts records which build it came from. Pass /v:BuildNumber=... at publish time. -->
    <SqlCmdVariable Include="BuildNumber">
      <DefaultValue>local</DefaultValue>
      <Value>$(SqlCmdVar__1)</Value>
    </SqlCmdVariable>
  </ItemGroup>
</Project>
